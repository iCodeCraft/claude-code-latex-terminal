{
  "description": "Terminal LaTeX display hooks",
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/message-display.py"
            ]
          }
        ]
      }
    ]
  }
}
